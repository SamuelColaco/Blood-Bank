// Phase 1 schema - Inventory bounded context.
// Naming follows the corrected design from DECISOES-HOTSPOTS.md:
// - No raw temperature column on blood_components (avoids row contention
//   on every sensor reading; see TemperatureReading below).
// - outbox_events + audit_logs implement the transactional outbox pattern
//   for the audit trail, so it never blocks a normal request.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BloodBagStatus {
  PROCESSING
  FINALIZED
}

enum EquipmentType {
  FREEZER
  REFRIGERATOR
  PLATELET_AGITATOR
}

enum ComponentType {
  RED_BLOOD_CELLS
  PLATELETS
  PLASMA
  CRYOPRECIPITATE
}

enum DonationPurpose {
  GENERAL
  AUTOLOGOUS
  DIRECTED
}

enum DonationType {
  WHOLE_BLOOD
  APHERESIS
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  featureFlags Json     @default("{}") @map("feature_flags")
  createdAt    DateTime @default(now()) @map("created_at")

  bloodBags                     BloodBag[]
  bloodComponents               BloodComponent[]
  equipment                     Equipment[]
  donors                        Donor[]
  donationAppointments          DonationAppointment[]
  clinicalQuestionnaireVersions ClinicalQuestionnaireVersion[]
  donations                     Donation[]
  hospitals                     Hospital[]
  hospitalRequests              HospitalRequest[]
  transportContainers           TransportContainer[]

  @@map("tenants")
}

model BloodBag {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  donationId            String          @map("donation_id")
  collectedAt           DateTime        @map("collected_at")
  donationPurpose       DonationPurpose @map("donation_purpose")
  designatedRecipientId String?         @map("designated_recipient_id")
  status                BloodBagStatus

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  components BloodComponent[]

  @@map("blood_bags")
}

model BloodComponent {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  bloodBagId            String          @map("blood_bag_id")
  equipmentId           String?         @map("equipment_id")
  componentType         ComponentType   @map("component_type")
  aboGroup              String          @map("abo_group")
  rhFactor              String          @map("rh_factor")
  extendedPhenotype     String?         @map("extended_phenotype")
  status                String // see ComponentStatus enum in domain layer
  collectedAt           DateTime        @map("collected_at")
  expiresAt             DateTime        @map("expires_at")
  isUnderReevaluation   Boolean         @default(false) @map("is_under_reevaluation")
  reservedBy            String?         @map("reserved_by")
  reservationKind       String?         @map("reservation_kind") // ELECTIVE | EMERGENCY
  reservationExpiresAt  DateTime?       @map("reservation_expires_at")
  donationPurpose       DonationPurpose @map("donation_purpose")
  designatedRecipientId String?         @map("designated_recipient_id")
  isIrradiated          Boolean         @default(false) @map("is_irradiated")
  isLeukoreduced        Boolean         @default(false) @map("is_leukoreduced")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  // ON DELETE RESTRICT: a blood bag can never be deleted while it still
  // has derived components — this is a regulatory traceability requirement,
  // not just a technical constraint.
  bloodBag  BloodBag   @relation(fields: [bloodBagId], references: [id], onDelete: Restrict)
  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@map("blood_components")
}

model Equipment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  equipmentType  EquipmentType @map("equipment_type")
  minTemperature Float         @map("min_temperature")
  maxTemperature Float         @map("max_temperature")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  temperatureReadings TemperatureReading[]
  components          BloodComponent[]

  @@map("equipment")
}

model TemperatureReading {
  id          String   @id @default(uuid())
  equipmentId String   @map("equipment_id")
  value       Float
  recordedAt  DateTime @default(now()) @map("recorded_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@map("temperature_readings")
}

// Transactional outbox: written in the SAME transaction as the aggregate
// state change. A background worker consumes this table and writes to
// audit_logs asynchronously - see docs/fase-1.md, section 3.
model OutboxEvent {
  id            String   @id @default(uuid())
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  eventName     String   @map("event_name")
  payload       Json
  occurredAt    DateTime @map("occurred_at")
  processed     Boolean  @default(false)

  @@map("outbox_events")
}

// Append-only audit trail. In production this table (or an entirely
// separate database/schema) should have UPDATE and DELETE revoked at the
// database permission level.
model AuditLog {
  id            String   @id @default(uuid())
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  eventName     String   @map("event_name")
  actorId       String?  @map("actor_id")
  payload       Json
  occurredAt    DateTime @map("occurred_at")

  @@map("audit_logs")
}

// Donation & Screening bounded context models
model Donor {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  fullName        String    @map("full_name")
  documentId      String    @map("document_id")
  birthDate       DateTime  @map("birth_date")
  gender          String // MALE | FEMALE
  status          String // ACTIVE | INACTIVE
  deferralEndDate DateTime? @map("deferral_end_date")
  lastDonationAt  DateTime? @map("last_donation_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  appointments DonationAppointment[]
  donations    Donation[]

  @@unique([tenantId, documentId])
  @@map("donors")
}

model DonationAppointment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  donorId     String   @map("donor_id")
  scheduledAt DateTime @map("scheduled_at")
  status      String // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  donor    Donor     @relation(fields: [donorId], references: [id])
  donation Donation?

  @@map("donation_appointments")
}

model ClinicalQuestionnaireVersion {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  versionNumber Int      @map("version_number")
  publishedAt   DateTime @map("published_at")
  publishedBy   String   @map("published_by")
  questions     Json
  createdAt     DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  donations Donation[]

  @@unique([tenantId, versionNumber])
  @@map("clinical_questionnaire_versions")
}

model Donation {
  id                     String          @id @default(uuid())
  tenantId               String          @map("tenant_id")
  donorId                String          @map("donor_id")
  appointmentId          String?         @unique @map("appointment_id")
  donationType           DonationType    @map("donation_type")
  donationPurpose        DonationPurpose @map("donation_purpose")
  designatedRecipientId  String?         @map("designated_recipient_id")
  questionnaireSnapshot  Json?           @map("questionnaire_snapshot")
  vitalSignsRecorded     Boolean         @default(false) @map("vital_signs_recorded")
  apheresisSession       Json?           @map("apheresis_session")
  weightInKg             Float?          @map("weight_in_kg")
  hemoglobinInGdl        Float?          @map("hemoglobin_in_gdl")
  bloodPressureSys       Int?            @map("blood_pressure_sys")
  bloodPressureDia       Int?            @map("blood_pressure_dia")
  collectedAt            DateTime?       @map("collected_at")
  questionnaireVersionId String?         @map("questionnaire_version_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  tenant        Tenant                        @relation(fields: [tenantId], references: [id])
  donor         Donor                         @relation(fields: [donorId], references: [id])
  appointment   DonationAppointment?          @relation(fields: [appointmentId], references: [id])
  questionnaire ClinicalQuestionnaireVersion? @relation(fields: [questionnaireVersionId], references: [id])

  @@map("donations")
}

// Distribuição bounded context models (Phase 3). See docs/SDD-FASE3.md.

model Hospital {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  requests HospitalRequest[]

  @@map("hospitals")
}

model HospitalRequest {
  id                         String   @id @default(uuid())
  tenantId                   String   @map("tenant_id")
  hospitalId                 String   @map("hospital_id")
  requestedAboGroup          String   @map("requested_abo_group")
  requestedRhFactor          String   @map("requested_rh_factor")
  requestedExtendedPhenotype String?  @map("requested_extended_phenotype")
  requiredIsIrradiated       Boolean  @default(false) @map("required_is_irradiated")
  requiredIsLeukoreduced     Boolean  @default(false) @map("required_is_leukoreduced")
  urgency                    String // ELECTIVE | EMERGENCY
  status                     String // see HospitalRequestStatus enum in domain layer
  linkedComponentId          String?  @map("linked_component_id")
  shortlist                  Json     @default("[]")
  crossmatchReference        String?  @map("crossmatch_reference")
  crossmatchConfirmedBy      String?  @map("crossmatch_confirmed_by")
  crossmatchConfirmedRole    String?  @map("crossmatch_confirmed_role")
  awaitingPickConfirmation   Boolean  @default(false) @map("awaiting_pick_confirmation")
  overrideLog                Json     @default("[]") @map("override_log")
  rejectionReason            String?  @map("rejection_reason")
  cancellationReason         String?  @map("cancellation_reason")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  hospital   Hospital             @relation(fields: [hospitalId], references: [id])
  containers TransportContainer[]

  @@map("hospital_requests")
}

model TransportContainer {
  id                String @id @default(uuid())
  tenantId          String @map("tenant_id")
  hospitalRequestId String @map("hospital_request_id")
  minTemperature    Float  @map("min_temperature")
  maxTemperature    Float  @map("max_temperature")

  tenant              Tenant                        @relation(fields: [tenantId], references: [id])
  request             HospitalRequest               @relation(fields: [hospitalRequestId], references: [id])
  temperatureReadings TransportTemperatureReading[]

  @@map("transport_containers")
}

// Mirrors TemperatureReading, but for a TransportContainer under way -
// readings are stored separately so a sensor write never touches the
// aggregate (same reasoning as Fase 1: SDD Fase 3, section 4.2).
model TransportTemperatureReading {
  id          String   @id @default(uuid())
  containerId String   @map("container_id")
  value       Float
  recordedAt  DateTime @default(now()) @map("recorded_at")

  container TransportContainer @relation(fields: [containerId], references: [id])

  @@map("transport_temperature_readings")
}
